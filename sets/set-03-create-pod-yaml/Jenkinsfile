pipeline {
    agent any

    environment {
        K8S_CREDENTIAL_ID = 'k8s-kubeconfig'
        POD_NAME          = 'prime-even-pod'
    }

    stages {
        stage('Create Pod via YAML') {
            steps {
                echo '=== Stage 1: Applying Kubernetes Pod YAML ==='
                withCredentials([file(credentialsId: "${K8S_CREDENTIAL_ID}", variable: 'KUBECONFIG')]) {
                    sh '''
                        kubectl apply -f sets/set-03-create-pod-yaml/pod.yaml
                    '''
                }
            }
        }

        stage('Verify Pod Status') {
            steps {
                echo '=== Stage 2: Waiting for Pod to be Ready in Cluster ==='
                withCredentials([file(credentialsId: "${K8S_CREDENTIAL_ID}", variable: 'KUBECONFIG')]) {
                    sh '''
                        kubectl wait --for=condition=Ready pod/${POD_NAME} --timeout=60s
                        kubectl get pod ${POD_NAME} -o wide
                    '''
                }
            }
        }

        stage('Display Application Output') {
            steps {
                echo '=== Stage 3: Fetching Execution Output (Prime & Even Numbers) ==='
                withCredentials([file(credentialsId: "${K8S_CREDENTIAL_ID}", variable: 'KUBECONFIG')]) {
                    sh '''
                        echo "========================= POD LOGS START ========================="
                        kubectl logs ${POD_NAME}
                        echo "========================== POD LOGS END =========================="
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Set 3 completed. Pod executed prime & even number calculation and verified in Kubernetes."
        }
    }
}
