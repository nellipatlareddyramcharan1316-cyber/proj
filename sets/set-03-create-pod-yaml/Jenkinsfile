pipeline {
    agent any

    stages {
        stage('Deploy Pod to Kubernetes') {
            steps {
                echo '=== Stage 1: Applying Kubernetes Pod YAML ==='
                script {
                    if (isUnix()) {
                        sh 'kubectl apply -f sets/set-03-create-pod-yaml/pod.yaml'
                    } else {
                        bat 'kubectl apply -f sets/set-03-create-pod-yaml/pod.yaml'
                    }
                }
            }
        }

        stage('Verify Pod Status') {
            steps {
                echo '=== Stage 2: Waiting for Pod to be Ready in Cluster ==='
                script {
                    if (isUnix()) {
                        sh 'kubectl wait --for=condition=Ready pod/prime-even-pod --timeout=60s'
                        sh 'kubectl get pod prime-even-pod -o wide'
                    } else {
                        bat 'kubectl wait --for=condition=Ready pod/prime-even-pod --timeout=60s'
                        bat 'kubectl get pod prime-even-pod -o wide'
                    }
                }
            }
        }

        stage('Display Application Output') {
            steps {
                echo '=== Stage 3: Fetching Execution Output (Prime & Even Numbers) ==='
                script {
                    if (isUnix()) {
                        sh 'kubectl logs prime-even-pod'
                    } else {
                        bat 'kubectl logs prime-even-pod'
                    }
                }
            }
        }
    }

    post {
        success {
            echo '🎉 SUCCESS: Set 3 completed. Pod executed prime & even number calculation and verified in Kubernetes!'
        }
    }
}
