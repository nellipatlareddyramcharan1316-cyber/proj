pipeline {
    agent any

    environment {
        K8S_CREDENTIAL_ID = 'k8s-kubeconfig'
        IMAGE_NAME        = "docker-k8s-demo:${BUILD_NUMBER}"
        DEPLOYMENT_NAME   = 'docker-k8s-app'
        CONTAINER_NAME    = 'app-container'
    }

    stages {
        stage('Build Docker Image') {
            steps {
                echo "=== Stage 1: Building Docker Image ${IMAGE_NAME} ==="
                sh """
                    docker build -t ${IMAGE_NAME} -t docker-k8s-demo:latest sets/set-12-docker-k8s-cicd
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo '=== Stage 2: Applying Deployment and Updating Image ==='
                withCredentials([file(credentialsId: "${K8S_CREDENTIAL_ID}", variable: 'KUBECONFIG')]) {
                    sh """
                        kubectl apply -f sets/set-12-docker-k8s-cicd/deployment.yaml
                        kubectl set image deployment/${DEPLOYMENT_NAME} ${CONTAINER_NAME}=${IMAGE_NAME}
                    """
                }
            }
        }

        stage('Verify Rollout') {
            steps {
                echo '=== Stage 3: Verifying Kubernetes Rollout with Newly Built Image ==='
                withCredentials([file(credentialsId: "${K8S_CREDENTIAL_ID}", variable: 'KUBECONFIG')]) {
                    sh """
                        kubectl rollout status deployment/${DEPLOYMENT_NAME} --timeout=90s
                        kubectl get deployment ${DEPLOYMENT_NAME} -o wide
                    """
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Set 12 completed. Docker image built and deployed to Kubernetes."
        }
    }
}
